<!-- Icons (24-unit stroke paths, as in the mockup) and the page templates
     that pair each page's view-model with its view. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="clr-namespace:VostokModManager.Wpf.ViewModels"
                    xmlns:v="clr-namespace:VostokModManager.Wpf.Views"
                    xmlns:c="clr-namespace:VostokModManager.Wpf.Controls">

    <c:ResourceKeyConverter x:Key="ResourceKeyToGeometry" />
    <c:VisibleWhenConverter x:Key="EmptyToCollapsed" />
    <c:VisibleWhenConverter x:Key="VisibleWhen" />
    <c:CheckLevelBrushConverter x:Key="CheckLevelToBrush" />
    <c:StatusBrushConverter x:Key="StatusToBrush" />
    <c:EnabledOpacityConverter x:Key="EnabledToOpacity" />
    <c:EqualsConverter x:Key="EqualsParam" />
    <c:HasTextConverter x:Key="HasText" />
    <c:TabVisibleConverter x:Key="TabVisible" />
    <c:IssueBrushConverter x:Key="IssueToBrush" />
    <!-- Any resource by key: a view-model names a brush ("B.SalmonText")
         and the view looks it up. Same converter as ResourceKeyToGeometry. -->
    <c:ResourceKeyConverter x:Key="ResourceKey" />

    <Geometry x:Key="Icon.Mods">M3,3 H10 V10 H3 Z M14,3 H21 V10 H14 Z M3,14 H10 V21 H3 Z M14,14 H21 V21 H14 Z</Geometry>
    <Geometry x:Key="Icon.Profiles">M12,3 L21,8 L12,13 L3,8 Z M3,13 L12,18 L21,13</Geometry>
    <Geometry x:Key="Icon.Saves">M5,3 H16 L19,6 V21 H5 Z M8,3 V9 H16 V3 M8,14 H16 V19 H8 Z</Geometry>
    <Geometry x:Key="Icon.Browse">M21,12 A9,9 0 1 1 3,12 A9,9 0 1 1 21,12 Z M3,12 H21 M12,3 C15,6.5 15,17.5 12,21 M12,3 C9,6.5 9,17.5 12,21</Geometry>
    <Geometry x:Key="Icon.Library">M3,4 H21 V9 H3 Z M5,9 V20 H19 V9 M10,13 H14</Geometry>
    <Geometry x:Key="Icon.Tools">M14.5,6.5 A4,4 0 0 0 19.5,11.5 L12,19 A2.1,2.1 0 0 1 9,16 L16.5,8.5 M14.5,6.5 L17,4</Geometry>
    <Geometry x:Key="Icon.Settings">M13.09,4.68 L14.33,2.28 A10.0,10.0 0 0 1 17.22,3.47 L16.40,6.05 A7.4,7.4 0 0 1 17.95,7.60 L20.53,6.78 A10.0,10.0 0 0 1 21.72,9.67 L19.32,10.91 A7.4,7.4 0 0 1 19.32,13.09 L21.72,14.33 A10.0,10.0 0 0 1 20.53,17.22 L17.95,16.40 A7.4,7.4 0 0 1 16.40,17.95 L17.22,20.53 A10.0,10.0 0 0 1 14.33,21.72 L13.09,19.32 A7.4,7.4 0 0 1 10.91,19.32 L9.67,21.72 A10.0,10.0 0 0 1 6.78,20.53 L7.60,17.95 A7.4,7.4 0 0 1 6.05,16.40 L3.47,17.22 A10.0,10.0 0 0 1 2.28,14.33 L4.68,13.09 A7.4,7.4 0 0 1 4.68,10.91 L2.28,9.67 A10.0,10.0 0 0 1 3.47,6.78 L6.05,7.60 A7.4,7.4 0 0 1 7.60,6.05 L6.78,3.47 A10.0,10.0 0 0 1 9.67,2.28 L10.91,4.68 A7.4,7.4 0 0 1 13.09,4.68 Z M15,12 A3,3 0 1 1 9,12 A3,3 0 1 1 15,12 Z</Geometry>
    <Geometry x:Key="Icon.Search">M18,11 A7,7 0 1 1 4,11 A7,7 0 1 1 18,11 Z M20,20 L16,16</Geometry>
    <Geometry x:Key="Icon.Play">M6,3 L21,12 L6,21 Z</Geometry>
    <Geometry x:Key="Icon.Close">M6,6 L18,18 M18,6 L6,18</Geometry>
    <Geometry x:Key="Icon.Max">M5,5 H19 V19 H5 Z</Geometry>
    <Geometry x:Key="Icon.Restore">M8,8 H19 V19 H8 Z M5,16 V5 H16</Geometry>
    <Geometry x:Key="Icon.Min">M5,12 H19</Geometry>

    <!-- A 24-unit stroke icon drawn in the current foreground colour. -->
    <Style x:Key="IconPath" TargetType="Path">
        <Setter Property="Width" Value="18" />
        <Setter Property="Height" Value="18" />
        <Setter Property="Stretch" Value="Uniform" />
        <Setter Property="StrokeThickness" Value="1.6" />
        <Setter Property="StrokeLineJoin" Value="Round" />
        <Setter Property="StrokeStartLineCap" Value="Round" />
        <Setter Property="StrokeEndLineCap" Value="Round" />
        <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Control}}" />
        <Setter Property="SnapsToDevicePixels" Value="False" />
    </Style>

    <DataTemplate DataType="{x:Type vm:ModsViewModel}">
        <v:ModsView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:ProfilesViewModel}">
        <v:ProfilesView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:BrowseViewModel}">
        <v:BrowseView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
        <v:SettingsView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:SavesViewModel}">
        <v:SavesView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:ToolsViewModel}">
        <v:ToolsView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:LibraryViewModel}">
        <v:LibraryView />
    </DataTemplate>

</ResourceDictionary>
