<Project Sdk="Microsoft.NET.Sdk">

  <!-- The manager's front end, drawn in Road to Vostok's own UI language
       (Lora, flat grey panels, hairlines, white selection). Shared
       settings (version, editions, single-file release publish) come
       from Directory.Build.props/.targets.

       The .exe names are what the self-update matches a GitHub release
       asset against (ManagerRelease.AssetFor), so they must not change:
         EnableAI=true   →  VostokModManagerAI.exe          publish/ai/
         EnableAI=false  →  VostokModManagerIntegrated.exe  publish/integrated/ -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <UseWPF>true</UseWPF>
    <RootNamespace>VostokModManager.Wpf</RootNamespace>
  </PropertyGroup>

  <PropertyGroup Condition="'$(EnableAI)' == 'true'">
    <AssemblyName>VostokModManagerAI</AssemblyName>
    <Product>Vostok Mod Manager AI</Product>
    <ApplicationIcon>icon.ico</ApplicationIcon>
  </PropertyGroup>
  <PropertyGroup Condition="'$(EnableAI)' != 'true'">
    <AssemblyName>VostokModManagerIntegrated</AssemblyName>
    <Product>Vostok Mod Manager Integrated</Product>
    <ApplicationIcon>icon-integrated.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\VostokModManager.Core\VostokModManager.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.2.2" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2792.45" />
  </ItemGroup>

  <!-- Lora, the game's UI typeface (SIL Open Font License, see Fonts/OFL.txt). -->
  <ItemGroup>
    <Resource Include="Fonts\*.ttf" />
    <Resource Include="icon.ico" />
    <Resource Include="icon-integrated.ico" />
    <None Include="Fonts\OFL.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <PublishDir>$(MSBuildThisFileDirectory)..\..\publish\$(VmmEdition)\</PublishDir>
  </PropertyGroup>

</Project>
