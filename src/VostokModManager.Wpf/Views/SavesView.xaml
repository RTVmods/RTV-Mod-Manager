<!-- The Saves page, laid out like the Save Slots mod's own in-game panel
     (SaveSlots/mods/SaveSlots/SaveSlotsPanel.gd): a centred column with
     "Select Save Slot", the mod profile under it, a rule, one row per slot
     ("Name (#n)" | "Map: … | date" | profile | Continue / Switch & Load,
     New, Rename, Delete), a rule, then the footer buttons. -->
<UserControl x:Class="VostokModManager.Wpf.Views.SavesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:VostokModManager.Wpf.ViewModels">
    <UserControl.Resources>
        <Style x:Key="RowButton" TargetType="Button" BasedOn="{StaticResource Btn.Outline}">
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Margin" Value="12,0,0,0" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="32,26,32,32">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- page header, as on every page -->
            <StackPanel Margin="0,0,0,22">
                <TextBlock Text="SAVE SLOTS" Style="{StaticResource T.Label}" />
                <TextBlock Text="Saves" Style="{StaticResource T.H1}" Margin="0,2,0,0" />
                <TextBlock Text="The same five slots as the Save Slots panel in the game's menu. Each slot remembers the mod profile it runs under; launching it switches to that profile first."
                           Style="{StaticResource T.Muted}" Margin="0,6,0,0" MaxWidth="640" HorizontalAlignment="Left" />
            </StackPanel>

            <!-- the panel -->
            <Border Grid.Row="1" Style="{StaticResource Panel.Card}" MaxWidth="1120" MinWidth="840" HorizontalAlignment="Stretch"
                    VerticalAlignment="Top" Padding="24,18">
                <StackPanel>
                    <TextBlock Text="Select Save Slot" FontSize="28" HorizontalAlignment="Center" />
                    <TextBlock Text="{Binding Subtitle}" FontSize="16" Foreground="{StaticResource B.Text2}" HorizontalAlignment="Center" Margin="0,4,0,12" />

                    <Border Style="{StaticResource Panel.Warning}" Margin="0,0,0,12"
                            Visibility="{Binding Warning, Converter={StaticResource VisibleWhen}}">
                        <TextBlock Text="{Binding Warning}" Style="{StaticResource T.Body}" FontSize="13" Foreground="{StaticResource B.AmberText}" />
                    </Border>

                    <Border Height="1" Background="{StaticResource B.Hairline}" Margin="0,0,0,10" />

                    <ItemsControl ItemsSource="{Binding Slots}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:SlotCard}">
                                <Border x:Name="row" Background="{StaticResource B.Raised}" BorderBrush="Transparent" BorderThickness="1"
                                        MinHeight="64" Padding="12,6" Margin="0,0,0,6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="180" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <!-- "Name (#n)" -->
                                        <TextBlock Text="{Binding NameLabel}" FontSize="18" VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding NameLabel}" />

                                        <!-- "Map: … | date", Empty, [DEAD]; and whether the profile's mods are here -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0">
                                            <TextBlock x:Name="info" FontSize="14" Foreground="{StaticResource B.Text}" TextWrapping="Wrap">
                                                <Run Text="{Binding Info, Mode=OneWay}" /><Run x:Name="dead" Text="" />
                                            </TextBlock>
                                            <TextBlock Text="{Binding ModCheck}" FontSize="12" Foreground="{StaticResource B.SalmonText}" TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding ModCheck}"
                                                       Visibility="{Binding ModCheckBad, Converter={StaticResource VisibleWhen}}" />
                                            <TextBlock Text="last played" FontSize="12" Foreground="{StaticResource B.Text3}"
                                                       Visibility="{Binding IsNext, Converter={StaticResource VisibleWhen}}" />
                                        </StackPanel>

                                        <!-- the mod profile this slot runs under -->
                                        <ComboBox Grid.Column="2" Width="170" MinHeight="36" Margin="12,0,0,0" VerticalAlignment="Center"
                                                  ItemsSource="{Binding ProfileChoices}" SelectedItem="{Binding TiedProfile}"
                                                  ToolTip="Mod profile this slot runs under. Launching it switches to that profile first when another one is live."
                                                  AutomationProperties.Name="{Binding NameLabel, StringFormat=Profile for {0}}" />

                                        <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button x:Name="action" Style="{StaticResource Btn.Primary}" MinHeight="36" FontSize="14" Margin="12,0,0,0"
                                                    MinWidth="110" Content="{Binding ActionLabel}" ToolTip="{Binding ActionTip}" Command="{Binding LaunchCommand}"
                                                    Visibility="{Binding Slot.CanLaunch, Converter={StaticResource VisibleWhen}}" />
                                            <Button Style="{StaticResource RowButton}" MinWidth="110" Content="Continue" IsEnabled="False"
                                                    Visibility="{Binding Slot.CanLaunch, Converter={StaticResource VisibleWhen}, ConverterParameter=invert}" />
                                            <Button Style="{StaticResource RowButton}" MinWidth="70" Content="New" Command="{Binding NewGameCommand}"
                                                    ToolTip="Start a new run in this slot (an existing save is zipped to the backups folder first)." />
                                            <Button Style="{StaticResource RowButton}" MinWidth="90" Content="Rename" Command="{Binding RenameCommand}"
                                                    IsEnabled="{Binding Slot.CanRename}" />
                                            <Button Style="{StaticResource RowButton}" MinWidth="90" Content="Delete" Command="{Binding DeleteCommand}"
                                                    IsEnabled="{Binding Slot.CanDelete}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsEmpty}" Value="True">
                                        <Setter TargetName="info" Property="Foreground" Value="{StaticResource B.Text3}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Slot.Dead}" Value="True">
                                        <Setter TargetName="dead" Property="Text" Value="   [DEAD]" />
                                        <Setter TargetName="info" Property="Foreground" Value="{StaticResource B.SalmonText}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsNext}" Value="True">
                                        <Setter TargetName="row" Property="BorderBrush" Value="{StaticResource B.EdgeStrong}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding SwitchNeeded}" Value="True">
                                        <Setter TargetName="action" Property="MinWidth" Value="140" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Border Height="1" Background="{StaticResource B.Hairline}" Margin="0,4,0,14" />

                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Content="Open backups folder" Margin="0,0,10,0" MinHeight="36" Command="{Binding OpenBackupsCommand}" />
                            <Button Content="Back up all slots" MinHeight="36" Command="{Binding BackUpAllCommand}" />
                        </StackPanel>
                        <TextBlock Text="Deleting or starting over in a slot zips it to the backups folder first."
                                   Style="{StaticResource T.Muted}" VerticalAlignment="Center" />
                    </DockPanel>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
