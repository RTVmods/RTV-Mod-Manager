<!-- The Saves page: the Save Slots mod's five slots, with the same fields
     and actions as its in-game panel (SaveSlots/mods/SaveSlots/SaveSlotsPanel.gd:
     name (#n), map, last played, the profile the slot runs under, Continue or
     Switch & Load, New, Rename, Delete), drawn as a manager table like the
     Library and Mods pages. -->
<UserControl x:Class="VostokModManager.Wpf.Views.SavesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:VostokModManager.Wpf.ViewModels">
    <UserControl.Resources>
        <!-- Column widths shared by the heading row and every slot row. -->
        <GridLength x:Key="S.Num">64</GridLength>
        <GridLength x:Key="S.Map">150</GridLength>
        <GridLength x:Key="S.Played">160</GridLength>
        <GridLength x:Key="S.Profile">196</GridLength>
        <GridLength x:Key="S.Actions">390</GridLength>

        <Style x:Key="Tag" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontStyle" Value="Italic" />
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>

    <DockPanel Margin="32,26,32,22">

        <!-- header, as on every page -->
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,16">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Bottom">
                <Button Content="Open backups folder" MinHeight="44" Margin="0,0,10,0" Command="{Binding OpenBackupsCommand}" />
                <Button Content="Back up all slots" MinHeight="44" Command="{Binding BackUpAllCommand}" />
            </StackPanel>
            <StackPanel>
                <TextBlock Text="SAVE SLOTS" Style="{StaticResource T.Label}" />
                <TextBlock Text="Saves" Style="{StaticResource T.H1}" Margin="0,2,0,0" />
            </StackPanel>
        </DockPanel>

        <!-- what the slots run under, as a chip row like the Mods page -->
        <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,16">
            <Border Style="{StaticResource Panel.Notice}" Padding="12,6" Margin="0,0,8,8">
                <TextBlock Text="{Binding Subtitle}" FontSize="13" Foreground="{StaticResource B.Text2}" />
            </Border>
            <TextBlock Text="The same slots as the Save Slots panel in the game's menu. A slot tied to another profile switches to it first."
                       Style="{StaticResource T.Muted}" VerticalAlignment="Center" Margin="4,0,0,8" />
        </WrapPanel>

        <Border DockPanel.Dock="Top" Style="{StaticResource Panel.Warning}" Margin="0,0,0,16"
                Visibility="{Binding Warning, Converter={StaticResource VisibleWhen}}">
            <TextBlock Text="{Binding Warning}" Style="{StaticResource T.Body}" FontSize="13" Foreground="{StaticResource B.AmberText}" />
        </Border>

        <!-- footer note -->
        <Border DockPanel.Dock="Bottom" Style="{StaticResource Panel.Notice}" Margin="0,14,0,0">
            <TextBlock Text="Deleting a slot, or starting a new game over one, zips it to the backups folder first."
                       Style="{StaticResource T.Muted}" />
        </Border>

        <!-- column headings -->
        <Border DockPanel.Dock="Top" BorderBrush="{StaticResource B.Hairline}" BorderThickness="0,0,0,1" Height="34">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="{StaticResource S.Num}" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="{StaticResource S.Map}" />
                    <ColumnDefinition Width="{StaticResource S.Played}" />
                    <ColumnDefinition Width="{StaticResource S.Profile}" />
                    <ColumnDefinition Width="{StaticResource S.Actions}" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="SLOT" Style="{StaticResource T.Label}" Margin="14,0,0,0" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="SAVE" Style="{StaticResource T.Label}" VerticalAlignment="Center" />
                <TextBlock Grid.Column="2" Text="MAP" Style="{StaticResource T.Label}" VerticalAlignment="Center" />
                <TextBlock Grid.Column="3" Text="LAST PLAYED" Style="{StaticResource T.Label}" VerticalAlignment="Center" />
                <TextBlock Grid.Column="4" Text="MOD PROFILE" Style="{StaticResource T.Label}" VerticalAlignment="Center" />
            </Grid>
        </Border>

        <!-- the slots -->
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Slots}" Focusable="False">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:SlotCard}">
                        <Border x:Name="row" BorderBrush="{StaticResource B.HairlineSoft}" BorderThickness="0,0,0,1" Background="Transparent"
                                MinHeight="60">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="{StaticResource S.Num}" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="{StaticResource S.Map}" />
                                    <ColumnDefinition Width="{StaticResource S.Played}" />
                                    <ColumnDefinition Width="{StaticResource S.Profile}" />
                                    <ColumnDefinition Width="{StaticResource S.Actions}" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="{Binding NumberLabel}" FontSize="13" Foreground="{StaticResource B.Text3}"
                                           Margin="14,0,0,0" VerticalAlignment="Center" />

                                <!-- the save: name, tags, and the mods its profile is missing -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,8,12,8">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock x:Name="name" Text="{Binding SaveName}" FontSize="16" TextTrimming="CharacterEllipsis" />

                                        <TextBlock Text="dead" Style="{StaticResource Tag}" Foreground="{StaticResource B.SalmonText}"
                                                   Visibility="{Binding IsDead, Converter={StaticResource VisibleWhen}}" />
                                    </StackPanel>
                                    <TextBlock Text="Last played" ToolTip="The game continues this slot when you press Continue in its menu" FontSize="12" Foreground="{StaticResource B.Text3}" Margin="0,2,0,0"
                                               Visibility="{Binding IsNext, Converter={StaticResource VisibleWhen}}" />
                                    <TextBlock Text="{Binding ModCheck}" FontSize="12" Foreground="{StaticResource B.SalmonText}"
                                               TextTrimming="CharacterEllipsis" ToolTip="{Binding ModCheck}" Margin="0,2,0,0"
                                               Visibility="{Binding ModCheckBad, Converter={StaticResource VisibleWhen}}" />
                                </StackPanel>

                                <TextBlock Grid.Column="2" Text="{Binding MapText}" FontSize="14" Foreground="{StaticResource B.Text2}"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />

                                <StackPanel Grid.Column="3" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding PlayedText}" FontSize="14" Foreground="{StaticResource B.Text2}" />
                                    <TextBlock Text="{Binding PlayedAgo}" FontSize="12" Foreground="{StaticResource B.Text4}"
                                               Visibility="{Binding PlayedAgo, Converter={StaticResource VisibleWhen}}" />
                                </StackPanel>

                                <ComboBox Grid.Column="4" Margin="0,0,16,0" MinHeight="36" VerticalAlignment="Center"
                                          ItemsSource="{Binding ProfileChoices}" SelectedItem="{Binding TiedProfile}"
                                          ToolTip="The mod profile this slot runs under. Launching it switches to that profile first when another one is live."
                                          AutomationProperties.Name="{Binding NameLabel, StringFormat=Mod profile for {0}}" />

                                <!-- actions, right-aligned so every row's buttons line up -->
                                <StackPanel Grid.Column="5" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <Button Style="{StaticResource Btn.Quiet}" Content="Rename" Command="{Binding RenameCommand}"
                                            Visibility="{Binding Slot.CanRename, Converter={StaticResource VisibleWhen}}" />
                                    <Button Style="{StaticResource Btn.Quiet}" Content="Delete" Command="{Binding DeleteCommand}" Margin="0,0,8,0"
                                            Visibility="{Binding Slot.CanDelete, Converter={StaticResource VisibleWhen}}" />
                                    <Button Content="New game" MinHeight="36" MinWidth="100" Margin="0,0,8,0" Command="{Binding NewGameCommand}"
                                            ToolTip="Start a new run in this slot; an existing save is zipped to the backups folder first." />
                                    <Button Style="{StaticResource Btn.Primary}" Content="{Binding ActionLabel}" ToolTip="{Binding ActionTip}"
                                            MinHeight="36" Width="130" Command="{Binding LaunchCommand}"
                                            Visibility="{Binding Slot.CanLaunch, Converter={StaticResource VisibleWhen}}" />
                                    <Border Width="130" Visibility="{Binding Slot.CanLaunch, Converter={StaticResource VisibleWhen}, ConverterParameter=invert}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsEmpty}" Value="True">
                                <Setter TargetName="name" Property="Foreground" Value="{StaticResource B.Text4}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsNext}" Value="True">
                                <Setter TargetName="row" Property="Background" Value="{StaticResource B.Fill}" />
                            </DataTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="row" Property="Background" Value="{StaticResource B.Fill}" />
                            </Trigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</UserControl>
