<Window x:Class="VostokModManager.Wpf.Views.LibraryPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:VostokModManager.Wpf.ViewModels"
        Title="Add from the library"
        Width="700" Height="700" MinWidth="520" MinHeight="420"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource B.Rail}" Foreground="{StaticResource B.Text}"
        FontFamily="{StaticResource Font.Lora}" FontSize="{StaticResource Size.Body}" UseLayoutRounding="True">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="30" ResizeBorderThickness="6" GlassFrameThickness="0" />
    </WindowChrome.WindowChrome>
    <Border BorderBrush="{StaticResource B.Edge}" BorderThickness="1" Background="{StaticResource B.Rail}">
        <DockPanel Margin="28,24,28,22">
            <TextBlock DockPanel.Dock="Top" Text="ADD FROM THE LIBRARY" Style="{StaticResource T.Label}" />
            <TextBlock DockPanel.Dock="Top" Text="{Binding ProfileName}" Style="{StaticResource T.H2}" Margin="0,4,0,10" />
            <TextBlock DockPanel.Dock="Top" Style="{StaticResource T.Muted}" TextWrapping="Wrap" Margin="0,0,0,6"
                       Text="Mods you have installed before, kept in the library. Each is offered at its newest version; the Library page has the older ones." />

            <!-- filter -->
            <Grid DockPanel.Dock="Top" Margin="0,8,0,10">
                <TextBox x:Name="FilterBox" Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged}" Padding="16,5,5,5"
                         AutomationProperties.Name="Filter the library" />
                <Path Data="{StaticResource Icon.Search}" Style="{StaticResource IconPath}" Width="15" Height="15"
                      Stroke="{StaticResource B.Text3}" HorizontalAlignment="Left" Margin="11,0,0,0" IsHitTestVisible="False" />
                <TextBlock Text="Filter by name, id or version" Foreground="{StaticResource B.Text4}" VerticalAlignment="Center"
                           Margin="35,0,0,0" IsHitTestVisible="False"
                           Visibility="{Binding Text, ElementName=FilterBox, Converter={StaticResource VisibleWhen}, ConverterParameter=invert}" />
            </Grid>

            <DockPanel DockPanel.Dock="Bottom" Margin="0,16,0,0">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="Cancel" MinWidth="96" Margin="0,0,8,0" Click="OnCancel" />
                    <Button Style="{StaticResource Btn.Primary}" Content="{Binding AddText}" MinWidth="120"
                            Command="{Binding AddCommand}" />
                </StackPanel>
            </DockPanel>

            <TextBlock DockPanel.Dock="Bottom" Text="{Binding CountText}" Style="{StaticResource T.Muted}" Margin="0,8,0,0" />

            <Border BorderBrush="{StaticResource B.Hairline}" BorderThickness="0,1,0,1">
                <ListBox ItemsSource="{Binding ItemsView}" AutomationProperties.Name="Library mods">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:LibraryChoiceItem}">
                            <CheckBox IsChecked="{Binding IsChecked}" Margin="12,0,8,0" MinHeight="44"
                                      AutomationProperties.Name="{Binding Name}">
                                <StackPanel VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding Version}" FontSize="13" Foreground="{StaticResource B.Text2}"
                                                   VerticalAlignment="Center" Margin="10,0,0,0" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding Detail}" FontSize="12" Foreground="{StaticResource B.Text4}" />
                                </StackPanel>
                            </CheckBox>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>
        </DockPanel>
    </Border>
</Window>
