<UserControl x:Class="VostokModManager.Wpf.Views.LibraryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:VostokModManager.Wpf.ViewModels">
    <UserControl.Resources>
        <GridLength x:Key="L.Chevron">34</GridLength>
        <GridLength x:Key="L.Ver">96</GridLength>
        <GridLength x:Key="L.State">230</GridLength>
        <GridLength x:Key="L.Prof">190</GridLength>
        <GridLength x:Key="L.Size">80</GridLength>
        <GridLength x:Key="L.Act">170</GridLength>
        <Style x:Key="HeaderButton" TargetType="Button" BasedOn="{StaticResource Btn.Quiet}">
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Foreground" Value="{StaticResource B.Text3}" />
        </Style>
        <Style x:Key="RowButton" TargetType="Button" BasedOn="{StaticResource Btn.Outline}">
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="12,0" />
        </Style>
    </UserControl.Resources>

    <DockPanel Margin="32,26,32,22">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Bottom">
                <Border Width="280" Height="44" Background="{StaticResource B.Fill}" BorderBrush="{StaticResource B.EdgeSoft}" BorderThickness="1">
                    <DockPanel Margin="14,0">
                        <Path DockPanel.Dock="Left" Data="{StaticResource Icon.Search}" Style="{StaticResource IconPath}"
                              Width="15" Height="15" Stroke="{StaticResource B.Text2}" />
                        <Grid Margin="10,0,0,0">
                            <TextBlock Text="Search my mods" Foreground="{StaticResource B.Text4}" VerticalAlignment="Center"
                                       IsHitTestVisible="False"
                                       Visibility="{Binding Query, Converter={StaticResource VisibleWhen}, ConverterParameter=invert}" />
                            <TextBox Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}" Background="Transparent"
                                     BorderThickness="0" Padding="0" VerticalAlignment="Center" AutomationProperties.Name="Search my mods" />
                        </Grid>
                    </DockPanel>
                </Border>
                <Button Content="Open folder" Margin="10,0,0,0" MinHeight="44" Command="{Binding OpenFolderCommand}"
                        ToolTip="The library folder (mods\Library) where every downloaded version is kept" />
            </StackPanel>
            <StackPanel>
                <TextBlock Text="EVERY MOD YOU HAVE DOWNLOADED" Style="{StaticResource T.Label}" />
                <TextBlock Text="My Mods" Style="{StaticResource T.H1}" Margin="0,2,0,0" />
            </StackPanel>
        </DockPanel>
        <TextBlock DockPanel.Dock="Top" Text="{Binding Header}" Style="{StaticResource T.Muted}" Margin="0,0,0,4"
                   TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
        <TextBlock DockPanel.Dock="Top" Style="{StaticResource T.Muted}" Foreground="{StaticResource B.Text4}" Margin="0,0,0,16"
                   TextWrapping="Wrap"
                   Text="Add a mod to your loadout (the mods the game loads), take it out, or open it to pick another version. Taking a mod out keeps it here." />

        <!-- housekeeping -->
        <Border DockPanel.Dock="Bottom" Style="{StaticResource Panel.Notice}" Margin="0,14,0,0">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Clean up old versions" MinHeight="34" FontSize="13" Command="{Binding CleanUpCommand}"
                        ToolTip="Deletes versions that aren't the newest, aren't in the loadout and no profile uses" />
                <TextBlock Text="{Binding CleanupNote}" Style="{StaticResource T.Muted}" VerticalAlignment="Center" />
            </DockPanel>
        </Border>

        <!-- column header: click to sort -->
        <Border DockPanel.Dock="Top" BorderBrush="{StaticResource B.Hairline}" BorderThickness="0,0,0,1" Height="34">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="{StaticResource L.Chevron}" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="{StaticResource L.Ver}" />
                    <ColumnDefinition Width="{StaticResource L.State}" />
                    <ColumnDefinition Width="{StaticResource L.Prof}" />
                    <ColumnDefinition Width="{StaticResource L.Size}" />
                    <ColumnDefinition Width="{StaticResource L.Act}" />
                </Grid.ColumnDefinitions>
                <Button Grid.Column="1" Style="{StaticResource HeaderButton}" Content="MOD" Command="{Binding SortCommand}" CommandParameter="Mod" />
                <TextBlock Grid.Column="2" Text="NEWEST" Style="{StaticResource T.Label}" VerticalAlignment="Center" />
                <Button Grid.Column="3" Style="{StaticResource HeaderButton}" Content="LOADOUT" Command="{Binding SortCommand}" CommandParameter="State" />
                <Button Grid.Column="4" Style="{StaticResource HeaderButton}" Content="IN PROFILES" Command="{Binding SortCommand}" CommandParameter="Profiles" />
                <Button Grid.Column="5" Style="{StaticResource HeaderButton}" Content="SIZE" Command="{Binding SortCommand}" CommandParameter="Size" />
            </Grid>
        </Border>

        <Grid>
            <TextBlock Text="Nothing here yet. Mods you install, from Browse or from files, are kept here." Style="{StaticResource T.Muted}"
                       Margin="14,16,0,0" Visibility="{Binding IsEmpty, Converter={StaticResource VisibleWhen}}" />
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding Mods}" AutomationProperties.Name="My mods" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:MyModItem}">
                            <Border BorderBrush="{StaticResource B.HairlineSoft}" BorderThickness="0,0,0,1">
                                <StackPanel>
                                    <!-- the mod -->
                                    <Grid MinHeight="52">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="{StaticResource L.Chevron}" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="{StaticResource L.Ver}" />
                                            <ColumnDefinition Width="{StaticResource L.State}" />
                                            <ColumnDefinition Width="{StaticResource L.Prof}" />
                                            <ColumnDefinition Width="{StaticResource L.Size}" />
                                            <ColumnDefinition Width="{StaticResource L.Act}" />
                                        </Grid.ColumnDefinitions>
                                        <Button Style="{StaticResource Btn.Quiet}" Padding="0" MinHeight="0" Width="28" Height="28"
                                                Command="{Binding ToggleCommand}" AutomationProperties.Name="Show the versions"
                                                ToolTip="Show every version kept">
                                            <Path Width="12" Height="12" Stretch="None" StrokeThickness="1.6"
                                                  Stroke="{StaticResource B.Text}" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                  StrokeLineJoin="Round">
                                                <Path.Style>
                                                    <Style TargetType="Path">
                                                        <Setter Property="Data" Value="M 4,1.5 L 8.5,6 L 4,10.5" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                                                <Setter Property="Data" Value="M 1.5,4 L 6,8.5 L 10.5,4" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Path.Style>
                                            </Path>
                                        </Button>
                                        <StackPanel Grid.Column="1" Margin="0,0,8,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Sub}" FontSize="12" Foreground="{StaticResource B.Text4}"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="{Binding Newest}" FontSize="14" Foreground="{StaticResource B.Text2}"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="3" Text="{Binding StateText}" FontSize="13" VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" Margin="0,0,8,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{StaticResource B.Text3}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding InLoadout}" Value="True">
                                                            <Setter Property="Foreground" Value="{StaticResource B.Green}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Grid.Column="4" Text="{Binding ProfilesText}" FontSize="13" Foreground="{StaticResource B.Text3}"
                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,8,0" />
                                        <TextBlock Grid.Column="5" Text="{Binding SizeText}" FontSize="13" Foreground="{StaticResource B.Text3}"
                                                   VerticalAlignment="Center" />
                                        <Grid Grid.Column="6" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <Button Style="{StaticResource RowButton}" Content="Add to loadout" Command="{Binding AddCommand}"
                                                    IsEnabled="{Binding DataContext.IsBusy, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource EqualsParam}, ConverterParameter=False}"
                                                    Visibility="{Binding CanAdd, Converter={StaticResource VisibleWhen}}"
                                                    ToolTip="Install the newest version into the active profile" />
                                            <Button Style="{StaticResource Btn.Link}" Content="Remove from loadout" FontSize="13" Command="{Binding RemoveCommand}"
                                                    Visibility="{Binding InLoadout, Converter={StaticResource VisibleWhen}}"
                                                    ToolTip="Take it out of the active profile; its versions stay here" />
                                        </Grid>
                                    </Grid>

                                    <!-- its versions -->
                                    <ItemsControl ItemsSource="{Binding Versions}" Focusable="False" Margin="0,0,0,10"
                                                  Visibility="{Binding IsExpanded, Converter={StaticResource VisibleWhen}}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type vm:MyModVersion}">
                                                <Grid MinHeight="38">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="{StaticResource L.Chevron}" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="{StaticResource L.Ver}" />
                                                        <ColumnDefinition Width="{StaticResource L.State}" />
                                                        <ColumnDefinition Width="{StaticResource L.Prof}" />
                                                        <ColumnDefinition Width="{StaticResource L.Size}" />
                                                        <ColumnDefinition Width="{StaticResource L.Act}" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border Grid.Column="1" Grid.ColumnSpan="6" Background="{StaticResource B.Fill}" />
                                                    <TextBlock Grid.Column="1" Text="{Binding FileName}" FontSize="12" Foreground="{StaticResource B.Text4}"
                                                               VerticalAlignment="Center" Margin="14,0,8,0" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Grid.Column="2" Text="{Binding Version}" FontSize="13" Foreground="{StaticResource B.Text2}"
                                                               VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="3" Text="{Binding StateText}" FontSize="13" Foreground="{StaticResource B.Green}"
                                                               VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="5" Text="{Binding SizeText}" FontSize="12.5" Foreground="{StaticResource B.Text3}"
                                                               VerticalAlignment="Center" />
                                                    <StackPanel Grid.Column="6" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                                Margin="0,0,8,0">
                                                        <Button Style="{StaticResource Btn.Link}" Content="{Binding UseLabel}" FontSize="12.5" Command="{Binding UseCommand}"
                                                                Visibility="{Binding IsInUse, Converter={StaticResource VisibleWhen}, ConverterParameter=invert}"
                                                                ToolTip="Put this version in the loadout" />
                                                        <Button Style="{StaticResource Btn.Link}" Content="Delete" FontSize="12.5" Margin="12,0,0,0"
                                                                Foreground="{StaticResource B.SalmonText}" Command="{Binding DeleteCommand}"
                                                                ToolTip="Delete this version from the library (asks first)" />
                                                    </StackPanel>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</UserControl>
