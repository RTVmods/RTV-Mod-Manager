<Window x:Class="VostokModManager.Wpf.Views.ConflictDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:VostokModManager.Wpf.ViewModels"
        xmlns:svc="clr-namespace:VostokModManager.Services;assembly=VostokModManager.Core"
        xmlns:c="clr-namespace:VostokModManager.Wpf.Controls"
        Title="Conflict detail"
        Width="920" Height="680" MinWidth="680" MinHeight="420"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource B.Rail}" Foreground="{StaticResource B.Text}"
        FontFamily="{DynamicResource Font.Lora}" FontSize="{StaticResource Size.Body}" UseLayoutRounding="True">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="30" ResizeBorderThickness="6" GlassFrameThickness="0" />
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <Style x:Key="Row.Line" TargetType="Border">
            <Setter Property="BorderBrush" Value="{StaticResource B.HairlineSoft}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="MinHeight" Value="38" />
            <Setter Property="Padding" Value="0,8" />
        </Style>
        <Style x:Key="Head.Line" TargetType="Border">
            <Setter Property="BorderBrush" Value="{StaticResource B.Hairline}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="Height" Value="30" />
        </Style>
        <Style x:Key="Cell" TargetType="TextBlock" BasedOn="{StaticResource T.Body}">
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="LineHeight" Value="20" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,14,0" />
        </Style>
        <Style x:Key="CellMono" TargetType="TextBlock" BasedOn="{StaticResource T.Mono}">
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,14,0" />
        </Style>
    </Window.Resources>
    <Border BorderBrush="{StaticResource B.Edge}" BorderThickness="1" Background="{StaticResource B.Rail}">
        <DockPanel Margin="28,24,28,22">
            <TextBlock DockPanel.Dock="Top" Text="{Binding Kind}" Style="{StaticResource T.Label}"
                       Foreground="{Binding KindBrushKey, Converter={StaticResource ResourceKey}}" />
            <TextBlock DockPanel.Dock="Top" c:MarkdownView.InlineText="{Binding Title}" Style="{StaticResource T.H2}" FontSize="22" Margin="0,4,0,6" />
            <TextBlock DockPanel.Dock="Top" Text="{Binding Subtitle}" Style="{StaticResource T.Muted}" Margin="0,0,0,16" />

            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button Style="{StaticResource Btn.Primary}" Content="Close" MinWidth="96" IsDefault="True" Click="OnClose" />
            </StackPanel>

            <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
                <StackPanel>
                    <!-- what happens in game -->
                    <Border Style="{StaticResource Panel.Notice}" Margin="0,0,0,16"
                            Visibility="{Binding HasExplanation, Converter={StaticResource VisibleWhen}}">
                        <TextBlock Text="{Binding Explanation}" Style="{StaticResource T.Body}" FontSize="13.5" LineHeight="20"
                                   TextWrapping="Wrap" Foreground="{StaticResource B.Text2}" />
                    </Border>

                    <!-- each mod and its part in the conflict -->
                    <StackPanel>
                        <Border Style="{StaticResource Head.Line}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="280" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="MOD" Style="{StaticResource T.Label}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="ITS PART" Style="{StaticResource T.Label}" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <ItemsControl ItemsSource="{Binding Values}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type svc:ConflictValueRow}">
                                    <Border Style="{StaticResource Row.Line}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="280" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding ModName}" Style="{StaticResource Cell}" />
                                            <TextBlock Grid.Column="1" Text="{Binding Value}" Style="{StaticResource CellMono}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Border>
</Window>
