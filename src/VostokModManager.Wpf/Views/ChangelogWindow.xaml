<Window x:Class="VostokModManager.Wpf.Views.ChangelogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:VostokModManager.Wpf.Controls"
        Title="Changelog"
        Width="720" Height="680" MinWidth="480" MinHeight="360"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource B.Rail}" Foreground="{StaticResource B.Text}"
        FontFamily="{DynamicResource Font.Lora}" FontSize="{StaticResource Size.Body}" UseLayoutRounding="True">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="30" ResizeBorderThickness="6" GlassFrameThickness="0" />
    </WindowChrome.WindowChrome>
    <Border BorderBrush="{StaticResource B.Edge}" BorderThickness="1" Background="{StaticResource B.Rail}">
        <DockPanel Margin="28,24,28,22">
            <TextBlock DockPanel.Dock="Top" Text="CHANGELOG" Style="{StaticResource T.Label}" />
            <TextBlock DockPanel.Dock="Top" x:Name="ModName" Style="{StaticResource T.H2}" Margin="0,4,0,14" />
            <Button DockPanel.Dock="Bottom" Content="Close" MinWidth="96" HorizontalAlignment="Right" Margin="0,16,0,0"
                    IsCancel="True" IsDefault="True" Click="OnClose" />
            <Border BorderBrush="{StaticResource B.Hairline}" BorderThickness="0,1,0,1">
                <c:MarkdownView x:Name="Notes" FontSize="14" Foreground="{StaticResource B.Text2}" />
            </Border>
        </DockPanel>
    </Border>
</Window>
