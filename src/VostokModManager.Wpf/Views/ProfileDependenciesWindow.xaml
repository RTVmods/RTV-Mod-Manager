<Window x:Class="VostokModManager.Wpf.Views.ProfileDependenciesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:svc="clr-namespace:VostokModManager.Services;assembly=VostokModManager.Core"
        Width="760" Height="640" MinWidth="560" MinHeight="400"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource B.Rail}" Foreground="{StaticResource B.Text}"
        FontFamily="{StaticResource Font.Lora}" FontSize="{StaticResource Size.Body}" UseLayoutRounding="True">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="30" ResizeBorderThickness="6" GlassFrameThickness="0" />
    </WindowChrome.WindowChrome>
    <Border BorderBrush="{StaticResource B.Edge}" BorderThickness="1" Background="{StaticResource B.Rail}">
        <DockPanel Margin="28,24,28,22">
            <TextBlock DockPanel.Dock="Top" Text="DEPENDENCIES" Style="{StaticResource T.Label}" />
            <TextBlock DockPanel.Dock="Top" x:Name="TitleText" Style="{StaticResource T.H2}" Margin="0,4,0,8" />
            <TextBlock DockPanel.Dock="Top" Text="{Binding Summary}" Style="{StaticResource T.Muted}" Margin="0,0,0,14" />

            <DockPanel DockPanel.Dock="Bottom" Margin="0,16,0,0" LastChildFill="False">
                <Button DockPanel.Dock="Right" Content="Close" IsCancel="True" IsDefault="True" Click="OnClose" />
            </DockPanel>

            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Dependents}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type svc:ProfileDependent}">
                            <Border BorderBrush="{StaticResource B.HairlineSoft}" BorderThickness="0,0,0,1" Padding="2,12,2,12">
                                <StackPanel>
                                    <TextBlock Text="{Binding Label}" FontSize="16" FontWeight="Medium" TextTrimming="CharacterEllipsis" />
                                    <ItemsControl ItemsSource="{Binding Dependencies}" Focusable="False" Margin="0,6,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type svc:ProfileDependencyState}">
                                                <Grid Margin="0,3,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="26" />
                                                        <ColumnDefinition Width="220" />
                                                        <ColumnDefinition Width="80" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock x:Name="icon" Text="{Binding Icon}" FontSize="14" Foreground="{StaticResource B.Green}" />
                                                    <TextBlock Grid.Column="1" Text="{Binding DepId}" Style="{StaticResource T.Mono}" FontSize="13"
                                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                                    <TextBlock Grid.Column="2" x:Name="kind" Text="required" FontSize="12"
                                                               Foreground="{StaticResource B.Text3}" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="3" x:Name="status" Text="{Binding StatusText}" FontSize="13"
                                                               Foreground="{StaticResource B.Text2}" VerticalAlignment="Center" TextWrapping="Wrap" />
                                                </Grid>
                                                <DataTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding Required}" Value="False">
                                                        <Setter TargetName="kind" Property="Text" Value="optional" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="{x:Static svc:DependencyStatus.Disabled}">
                                                        <Setter TargetName="icon" Property="Foreground" Value="{StaticResource B.AmberText}" />
                                                        <Setter TargetName="status" Property="Foreground" Value="{StaticResource B.AmberText}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="{x:Static svc:DependencyStatus.Missing}">
                                                        <Setter TargetName="icon" Property="Foreground" Value="{StaticResource B.SalmonText}" />
                                                        <Setter TargetName="status" Property="Foreground" Value="{StaticResource B.SalmonText}" />
                                                    </DataTrigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </DockPanel>
    </Border>
</Window>
