<UserControl x:Class="VostokModManager.Wpf.Views.ToolsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:VostokModManager.Wpf.ViewModels"
             xmlns:svc="clr-namespace:VostokModManager.Services;assembly=VostokModManager.Core">
    <UserControl.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock" BasedOn="{StaticResource T.Label}">
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock" BasedOn="{StaticResource T.H2}">
            <Setter Property="FontSize" Value="20" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>
    </UserControl.Resources>

    <DockPanel Margin="32,26,32,22">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,14">
            <TextBlock Text="FOR MOD AUTHORS AND BUG REPORTS" Style="{StaticResource T.Label}" />
            <TextBlock Text="Tools" Style="{StaticResource T.H1}" Margin="0,2,0,0" />
        </StackPanel>

        <Border DockPanel.Dock="Top" BorderBrush="{StaticResource B.Hairline}" BorderThickness="0,0,0,1" Margin="0,0,0,20">
            <StackPanel Orientation="Horizontal">
                <RadioButton Style="{StaticResource Tab.Item}" GroupName="toolsTab" Content="Log analysis"
                             IsChecked="{Binding Tab, Converter={StaticResource EqualsParam}, ConverterParameter=log, Mode=OneWay}"
                             Command="{Binding SetTabCommand}" CommandParameter="log" />
                <RadioButton Style="{StaticResource Tab.Item}" GroupName="toolsTab" Content="Mod Packager"
                             IsChecked="{Binding Tab, Converter={StaticResource EqualsParam}, ConverterParameter=packager, Mode=OneWay}"
                             Command="{Binding SetTabCommand}" CommandParameter="packager" />
                <RadioButton Style="{StaticResource Tab.Item}" GroupName="toolsTab" Content="Support package"
                             IsChecked="{Binding Tab, Converter={StaticResource EqualsParam}, ConverterParameter=support, Mode=OneWay}"
                             Command="{Binding SetTabCommand}" CommandParameter="support" />
            </StackPanel>
        </Border>

        <Grid>
            <!-- ═══ log analysis ═══ -->
            <Grid Visibility="{Binding Tab, Converter={StaticResource TabVisible}, ConverterParameter=log}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="300" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <DockPanel Margin="0,0,24,0">
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <Button DockPanel.Dock="Right" Style="{StaticResource Btn.Quiet}" Content="Refresh" Command="{Binding LoadLogsCommand}" />
                        <TextBlock Text="GAME LOGS" Style="{StaticResource T.Label}" VerticalAlignment="Center" />
                    </DockPanel>
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource T.Muted}" Margin="0,4,0,0"
                               Text="No game logs yet. Play once with the Mod Loader and its log shows up here."
                               Visibility="{Binding HasLogs, Converter={StaticResource VisibleWhen}, ConverterParameter=invert}" />
                    <ListBox ItemsSource="{Binding Logs}" SelectedItem="{Binding SelectedLog}" AutomationProperties.Name="Logs">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type svc:LogFileItem}">
                                <TextBlock Text="{Binding Label}" FontSize="13" Margin="10,10" TextWrapping="Wrap" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
                <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                    <!-- Claude's reading (AI edition) -->
                    <Border Style="{StaticResource Panel.Notice}" Margin="0,0,0,20"
                            Visibility="{Binding IsAiEdition, Converter={StaticResource VisibleWhen}}">
                        <StackPanel>
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="Analyze with Claude" Command="{Binding AnalyzeWithClaudeCommand}" />
                                <TextBlock Text="Claude reads the log and explains what went wrong, with a load order that should fix it."
                                           Style="{StaticResource T.Muted}" VerticalAlignment="Center" Margin="0,0,12,0" />
                            </DockPanel>
                            <TextBlock Text="{Binding Diagnosis}" Style="{StaticResource T.Body}" FontSize="14" Margin="0,12,0,0"
                                       Visibility="{Binding Diagnosis, Converter={StaticResource VisibleWhen}}" />
                            <ItemsControl ItemsSource="{Binding DiagnosisIssues}" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource Panel.Conflict}" Margin="0,10,0,0">
                                            <TextBlock Text="{Binding}" Style="{StaticResource T.Body}" FontSize="14" />
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <StackPanel Visibility="{Binding HasProposedOrder, Converter={StaticResource VisibleWhen}}" Margin="0,12,0,0">
                                <TextBlock Text="PROPOSED LOAD ORDER" Style="{StaticResource T.Label}" Margin="0,0,0,6" />
                                <ItemsControl ItemsSource="{Binding ProposedOrder}" Focusable="False">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" FontSize="14" Margin="0,2" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Button Style="{StaticResource Btn.Primary}" Content="Apply this load order" HorizontalAlignment="Left"
                                        Margin="0,10,0,0" Command="{Binding ApplyProposedOrderCommand}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <StackPanel DataContext="{Binding Report}">
                        <TextBlock Text="{Binding HeaderText}" Style="{StaticResource T.Muted}" Margin="0,0,0,18" />

                        <TextBlock Text="Functions hooked by more than one mod" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="{Binding HookNote}" Style="{StaticResource T.Muted}" Margin="0,0,0,8"
                                   Visibility="{Binding HookNote, Converter={StaticResource VisibleWhen}}" />
                        <ItemsControl ItemsSource="{Binding HookClashes}" Margin="0,0,0,22" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type svc:LogHookClashRow}">
                                    <Border BorderBrush="{StaticResource B.HairlineSoft}" BorderThickness="0,0,0,1" Padding="0,8">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Target}" Style="{StaticResource T.Mono}" Foreground="{StaticResource B.Text}" />
                                            <TextBlock Text="{Binding Mods}" FontSize="13" Foreground="{StaticResource B.Text2}" TextWrapping="Wrap" Margin="0,3,0,0" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="Scripts replaced by more than one mod" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="{Binding OverrideNote}" Style="{StaticResource T.Muted}" Margin="0,0,0,8"
                                   Visibility="{Binding OverrideNote, Converter={StaticResource VisibleWhen}}" />
                        <ItemsControl ItemsSource="{Binding OverrideClashes}" Margin="0,0,0,22" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type svc:LogOverrideClashRow}">
                                    <Border BorderBrush="{StaticResource B.HairlineSoft}" BorderThickness="0,0,0,1" Padding="0,8">
                                        <StackPanel>
                                            <TextBlock Text="{Binding VanillaPath}" Style="{StaticResource T.Mono}" Foreground="{StaticResource B.Text}" />
                                            <TextBlock FontSize="13" Foreground="{StaticResource B.Text2}" TextWrapping="Wrap" Margin="0,3,0,0">
                                                <Run Text="{Binding Mods, Mode=OneWay}" /><Run Text="  ·  wins: " /><Run Text="{Binding Winner, Mode=OneWay}" Foreground="{StaticResource B.Text}" />
                                            </TextBlock>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="Errors and warnings" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="{Binding IssueNote}" Style="{StaticResource T.Muted}" Margin="0,0,0,8"
                                   Visibility="{Binding IssueNote, Converter={StaticResource VisibleWhen}}" />
                        <ItemsControl ItemsSource="{Binding Issues}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type svc:LogIssueRow}">
                                    <Border BorderBrush="{StaticResource B.HairlineSoft}" BorderThickness="0,0,0,1" Padding="0,8">
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Left" Width="90" Text="{Binding Severity}" FontSize="12"
                                                       Foreground="{Binding Level, Converter={StaticResource IssueToBrush}}" />
                                            <TextBlock DockPanel.Dock="Left" Width="160" Text="{Binding Mod}" FontSize="13"
                                                       Foreground="{StaticResource B.Text2}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Message}" Style="{StaticResource T.Mono}" />
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- ═══ mod packager ═══ -->
            <Grid DataContext="{Binding Packager}" AllowDrop="True" Drop="OnPackagerDrop" DragOver="OnPackagerDragOver"
                  Visibility="{Binding DataContext.Tab, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource TabVisible}, ConverterParameter=packager}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="28" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Drop a .vmz, .zip or a mod folder here, or pick one." Style="{StaticResource T.Muted}" Margin="0,0,0,14" />
                        <TextBlock Text="MOD TO PACKAGE" Style="{StaticResource FieldLabel}" />
                        <DockPanel Margin="0,0,0,14">
                            <Button DockPanel.Dock="Right" Content="Folder…" Margin="8,0,0,0" Command="{Binding BrowseFolderCommand}" />
                            <Button DockPanel.Dock="Right" Content="Archive…" Margin="8,0,0,0" Command="{Binding BrowseArchiveCommand}" />
                            <TextBox Text="{Binding SourcePath, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Mod to package" />
                        </DockPanel>
                        <TextBlock Text="SAVE AS" Style="{StaticResource FieldLabel}" />
                        <DockPanel Margin="0,0,0,18">
                            <Button DockPanel.Dock="Right" Content="Browse…" Margin="8,0,0,0" Command="{Binding BrowseOutputCommand}" />
                            <TextBox Text="{Binding OutputPath, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Save as" />
                        </DockPanel>

                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="MOD ID" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding ModId, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Mod id" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="NAME" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Name" />
                            </StackPanel>
                        </Grid>
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="VERSION" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding Version, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Version" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="PRIORITY" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding Priority, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Priority" />
                            </StackPanel>
                            <StackPanel Grid.Column="4">
                                <TextBlock Text="AUTHOR" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding Author, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Author" />
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="VOSTOKMODS PAGE OR SLUG" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding SourceText, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,14" AutomationProperties.Name="VostokMods page" />
                        <TextBlock Text="DESCRIPTION" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap"
                                 MinHeight="70" Margin="0,0,0,18" AutomationProperties.Name="Description" />

                        <WrapPanel>
                            <Button Style="{StaticResource Btn.Primary}" Content="Build .vmz" Margin="0,0,8,8" Command="{Binding BuildCommand}" />
                            <Button Content="Export mod list…" Margin="0,0,8,8" Command="{Binding ExportListCommand}" />
                            <Button Content="Build modpack…" Margin="0,0,8,8" Command="{Binding BuildModpackCommand}" />
                            <Button Content="Open mod list…" Margin="0,0,8,8" Command="{Binding OpenListCommand}" />
                            <Button Style="{StaticResource Btn.Quiet}" Content="Reload mod.txt" Margin="0,0,8,8" Command="{Binding ReloadManifestCommand}" />
                            <Button Style="{StaticResource Btn.Quiet}" Content="Start over" Margin="0,0,8,8" Command="{Binding ResetCommand}" />
                        </WrapPanel>
                    </StackPanel>
                </ScrollViewer>

                <DockPanel Grid.Column="2">
                    <TextBlock DockPanel.Dock="Top" Text="DEPENDENCIES" Style="{StaticResource FieldLabel}" />
                    <TextBox DockPanel.Dock="Top" Text="{Binding DependencyFilter, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"
                             AutomationProperties.Name="Filter dependencies" />
                    <Border DockPanel.Dock="Bottom" Style="{StaticResource Panel.Notice}" Margin="0,12,0,0" MaxHeight="150">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding Log}" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" Style="{StaticResource T.Mono}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                    <Grid DockPanel.Dock="Bottom" Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="OTHER REQUIRED (URL OR ID)" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding CustomRequired, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" MinHeight="54"
                                     AutomationProperties.Name="Other required dependencies" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="OTHER OPTIONAL" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding CustomOptional, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" MinHeight="54"
                                     AutomationProperties.Name="Other optional dependencies" />
                        </StackPanel>
                    </Grid>
                    <Grid DockPanel.Dock="Top" Height="28">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="80" />
                            <ColumnDefinition Width="80" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="INSTALLED MOD" Style="{StaticResource T.Label}" Margin="10,0,0,0" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="REQUIRED" Style="{StaticResource T.Label}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2" Text="OPTIONAL" Style="{StaticResource T.Label}" VerticalAlignment="Center" />
                    </Grid>
                    <ListBox ItemsSource="{Binding Dependencies}" AutomationProperties.Name="Dependencies">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:PackagerDepItem}">
                                <Grid MinHeight="40">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="80" />
                                        <ColumnDefinition Width="80" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="10,0,8,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Row.DisplayName}" FontSize="14" TextTrimming="CharacterEllipsis" />
                                        <TextBlock FontSize="12" Foreground="{StaticResource B.Text4}" TextTrimming="CharacterEllipsis">
                                            <Run Text="{Binding Row.ModId, Mode=OneWay}" /><Run Text="  ·  " /><Run Text="{Binding Row.SourceText, Mode=OneWay}" />
                                        </TextBlock>
                                    </StackPanel>
                                    <CheckBox Grid.Column="1" IsChecked="{Binding Required}" AutomationProperties.Name="Required" />
                                    <CheckBox Grid.Column="2" IsChecked="{Binding Optional}" AutomationProperties.Name="Optional" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Grid>

            <!-- ═══ support package ═══ -->
            <StackPanel MaxWidth="720" HorizontalAlignment="Left"
                        Visibility="{Binding Tab, Converter={StaticResource TabVisible}, ConverterParameter=support}">
                <TextBlock Text="One file to attach to a bug report" Style="{StaticResource SectionTitle}" />
                <TextBlock Text="It holds your mod list, mod_config.cfg and the game's logs, so a mod author can see what you were running. Nothing else from your PC goes in."
                           Style="{StaticResource T.Body}" Foreground="{StaticResource B.Text2}" Margin="0,0,0,16" />
                <Border Style="{StaticResource Panel.Notice}" Margin="0,0,0,16">
                    <TextBlock Text="{Binding SupportSummary}" Style="{StaticResource T.Mono}" />
                </Border>
                <CheckBox Content="Include the loader's own logs next to mod_config.cfg" IsChecked="{Binding IncludeRootLogs}" Margin="0,0,0,18" />
                <StackPanel Orientation="Horizontal">
                    <Button Style="{StaticResource Btn.Primary}" Content="Build support package…" Command="{Binding BuildSupportPackageCommand}" />
                    <TextBlock Text="{Binding SupportProgress}" Style="{StaticResource T.Muted}" VerticalAlignment="Center" Margin="14,0,0,0" />
                </StackPanel>
            </StackPanel>
        </Grid>
    </DockPanel>
</UserControl>
