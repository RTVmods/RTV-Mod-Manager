<Window x:Class="VostokModManager.Wpf.Views.MessageWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="520" SizeToContent="Height" MaxHeight="760" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource B.Rail}" Foreground="{StaticResource B.Text}"
        FontFamily="{StaticResource Font.Lora}" FontSize="{StaticResource Size.Body}"
        UseLayoutRounding="True">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="28" ResizeBorderThickness="0" GlassFrameThickness="0" />
    </WindowChrome.WindowChrome>
    <Border BorderBrush="{StaticResource B.Edge}" BorderThickness="1">
        <DockPanel Margin="28,26,28,22">
            <TextBlock x:Name="Kind" DockPanel.Dock="Top" Style="{StaticResource T.Label}" Margin="0,0,0,6" />
            <TextBlock x:Name="TitleText" DockPanel.Dock="Top" Style="{StaticResource T.H2}" FontSize="22" Margin="0,0,0,12" />
            <WrapPanel x:Name="Buttons" DockPanel.Dock="Bottom" HorizontalAlignment="Right" Margin="0,22,0,0" />
            <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="520">
                <StackPanel>
                    <TextBlock x:Name="Message" Style="{StaticResource T.Body}" Foreground="{StaticResource B.Text2}" />
                    <ContentPresenter x:Name="Extra" Margin="0,14,0,0" />
                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Border>
</Window>
