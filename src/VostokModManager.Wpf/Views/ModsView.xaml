<UserControl x:Class="VostokModManager.Wpf.Views.ModsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:VostokModManager.Wpf.ViewModels"
             xmlns:svc="clr-namespace:VostokModManager.Services;assembly=VostokModManager.Core"
             xmlns:c="clr-namespace:VostokModManager.Wpf.Controls"
             AllowDrop="True" Drop="OnFileDrop" DragOver="OnFileDragOver">
    <UserControl.Resources>
        <!-- Column widths shared by the header row and every mod row. -->
        <GridLength x:Key="Col.On">48</GridLength>
        <GridLength x:Key="Col.Pos">36</GridLength>
        <GridLength x:Key="Col.Ord">64</GridLength>
        <GridLength x:Key="Col.Ver">96</GridLength>
        <GridLength x:Key="Col.Status">156</GridLength>
        <SolidColorBrush x:Key="Tint.Testing" Color="#14E3B55A" />
        <SolidColorBrush x:Key="Tint.New" Color="#14A9D18E" />

        <ContextMenu x:Key="RowMenu" DataContext="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}">
            <MenuItem Header="Set load order…" Command="{Binding SetLoadOrderCommand}" />
            <MenuItem Header="Lock / unlock" Command="{Binding ToggleLockCommand}" />
            <MenuItem Header="Testing build" Command="{Binding ToggleTestingCommand}" />
            <MenuItem Header="Personal note…" Command="{Binding EditNoteCommand}" />
            <Separator />
            <MenuItem Header="Edit required dependencies…" Command="{Binding EditDependenciesCommand}" />
            <MenuItem Header="Link / change VostokMods page…" Command="{Binding LinkSelectedCommand}" />
            <MenuItem Header="Revert to an earlier version…" Command="{Binding RevertCommand}" />
            <MenuItem Header="Conflicts…" Command="{Binding ShowConflictsCommand}" />
            <Separator />
            <MenuItem Header="VostokMods page" Command="{Binding OpenPageCommand}" />
            <MenuItem Header="Show in folder" Command="{Binding ShowInFolderCommand}" />
            <Separator />
            <MenuItem Header="Remove…" Command="{Binding DeleteCommand}" />
        </ContextMenu>

        <!-- The load-order box: reads as text until focused, Enter commits. -->
        <Style x:Key="OrdBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Padding" Value="4,2" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{StaticResource B.Text3}" />
            <Setter Property="Width" Value="52" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource B.EdgeSoft}" />
                </Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter Property="Background" Value="{StaticResource B.Fill}" />
                    <Setter Property="Foreground" Value="{StaticResource B.Text}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- A mod row. -->
        <DataTemplate x:Key="ModRowTemplate" DataType="{x:Type vm:ModItem}">
            <Grid x:Name="row" MinHeight="44" Background="Transparent" ToolTip="{Binding Tooltip}"
                  ToolTipService.IsEnabled="{Binding Tooltip, Converter={StaticResource HasText}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="{StaticResource Col.On}" />
                    <ColumnDefinition Width="{StaticResource Col.Pos}" />
                    <ColumnDefinition Width="{StaticResource Col.Ord}" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="{StaticResource Col.Ver}" />
                    <ColumnDefinition Width="{StaticResource Col.Status}" />
                </Grid.ColumnDefinitions>
                <!-- the download band, along the whole row -->
                <ProgressBar Grid.ColumnSpan="6" VerticalAlignment="Bottom" Height="3" Minimum="0" Maximum="100"
                             Value="{Binding Download, TargetNullValue=0}" IsIndeterminate="False"
                             Background="Transparent" Foreground="{StaticResource B.Amber}" BorderThickness="0"
                             Visibility="{Binding IsDownloading, Converter={StaticResource VisibleWhen}}" />
                <CheckBox IsChecked="{Binding IsEnabled}" Margin="14,0,0,0"
                          AutomationProperties.Name="{Binding Name, StringFormat=Enable {0}}" />
                <TextBlock Grid.Column="1" Text="{Binding Position}" FontSize="12" Foreground="{StaticResource B.Text4}" VerticalAlignment="Center" />
                <TextBox Grid.Column="2" Style="{StaticResource OrdBox}" Text="{Binding PriorityText, UpdateSourceTrigger=PropertyChanged}"
                         VerticalAlignment="Center" KeyDown="OnOrdKeyDown" LostKeyboardFocus="OnOrdLostFocus"
                         AutomationProperties.Name="{Binding Name, StringFormat=Load order of {0}}" />
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center"
                            Opacity="{Binding IsEnabled, Converter={StaticResource EnabledToOpacity}}">
                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="  locked" FontSize="12" FontStyle="Italic" Foreground="{StaticResource B.Text4}"
                               Visibility="{Binding IsLocked, Converter={StaticResource VisibleWhen}}" />
                    <TextBlock Text="  note" FontSize="12" FontStyle="Italic" Foreground="{StaticResource B.Text4}"
                               Visibility="{Binding HasNote, Converter={StaticResource VisibleWhen}}" />
                    <TextBlock Text="  new" FontSize="12" FontStyle="Italic" Foreground="{StaticResource B.Green}"
                               Visibility="{Binding IsNew, Converter={StaticResource VisibleWhen}}" />
                </StackPanel>
                <TextBlock Grid.Column="4" Text="{Binding Version}" FontSize="14" Foreground="{StaticResource B.Text2}" VerticalAlignment="Center"
                           Opacity="{Binding IsEnabled, Converter={StaticResource EnabledToOpacity}}" />
                <Button Grid.Column="5" Style="{StaticResource Btn.Quiet}" HorizontalAlignment="Left" Padding="0" MinHeight="30"
                        Command="{Binding StatusClickCommand}" FontSize="13"
                        Foreground="{Binding StatusKind, Converter={StaticResource StatusToBrush}}" Content="{Binding Status}"
                        AutomationProperties.Name="{Binding Status}" />
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsTesting}" Value="True">
                    <Setter TargetName="row" Property="Background" Value="{StaticResource Tint.Testing}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsNew}" Value="True">
                    <Setter TargetName="row" Property="Background" Value="{StaticResource Tint.New}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- A pack's header row: click to collapse or expand the pack. -->
        <DataTemplate x:Key="PackRowTemplate" DataType="{x:Type vm:ModItem}">
            <Button Style="{StaticResource Btn.Quiet}" HorizontalContentAlignment="Stretch" MinHeight="38"
                    Command="{Binding DataContext.TogglePackCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                    CommandParameter="{Binding}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Right" Text="{Binding PackSummary}" FontSize="12"
                               Foreground="{StaticResource B.Text4}" />
                    <TextBlock Text="{Binding Name}" Foreground="{StaticResource B.Text2}" FontSize="13" FontWeight="SemiBold" />
                </DockPanel>
            </Button>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="560" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition x:Name="DetailsColumn" Width="400" MinWidth="300" MaxWidth="760" />
        </Grid.ColumnDefinitions>

        <!-- drag to widen or narrow the details panel -->
        <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" ResizeBehavior="PreviousAndNext"
                      Background="Transparent" Cursor="SizeWE" Focusable="False" />

        <!-- ═══ list column ═══════════════════════════════════════════ -->
        <DockPanel Margin="32,26,32,22">

            <!-- header: profile name, filter, install -->
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,16">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Bottom">
                    <Border Width="280" Height="44" Background="{StaticResource B.Fill}"
                            BorderBrush="{StaticResource B.EdgeSoft}" BorderThickness="1">
                        <DockPanel Margin="14,0">
                            <Path DockPanel.Dock="Left" Data="{StaticResource Icon.Search}" Style="{StaticResource IconPath}"
                                  Width="15" Height="15" Stroke="{StaticResource B.Text2}" />
                            <Grid Margin="10,0,0,0">
                                <TextBlock Text="Filter by name, id or file" Foreground="{StaticResource B.Text4}"
                                           VerticalAlignment="Center" IsHitTestVisible="False"
                                           Visibility="{Binding Query, Converter={StaticResource VisibleWhen}, ConverterParameter=invert}" />
                                <TextBox Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}" Background="Transparent"
                                         BorderThickness="0" Padding="0,0,22,0" VerticalAlignment="Center" KeyDown="OnFilterKeyDown"
                                         AutomationProperties.Name="Filter mods" />
                                <Button Style="{StaticResource Btn.Quiet}" HorizontalAlignment="Right" Padding="4,0" MinHeight="24"
                                        Content="×" FontSize="16" Command="{Binding ClearQueryCommand}" AutomationProperties.Name="Clear the filter"
                                        Visibility="{Binding Query, Converter={StaticResource VisibleWhen}}" />
                            </Grid>
                        </DockPanel>
                    </Border>
                    <Button Margin="10,0,0,0" MinHeight="44" Padding="18,0" FontSize="15" Click="OnInstallMenu">
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Install mod files (.vmz, modpack .zip, mod list .json)…" Command="{Binding InstallFilesCommand}" />
                                <MenuItem Header="Add from the library…" Command="{Binding AddFromLibraryCommand}" />
                                <MenuItem Header="Install from a VostokMods page URL…" Command="{Binding InstallFromUrlCommand}" />
                                <MenuItem Header="Import a modpack from VostokMods…" Command="{Binding ImportModpackUrlCommand}" />
                                <Separator />
                                <MenuItem Header="Save a mod-list template…" Command="{Binding SaveListTemplateCommand}" />
                            </ContextMenu>
                        </Button.ContextMenu>
                        <TextBlock Text="Install mod ▾" />
                    </Button>
                </StackPanel>
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="ACTIVE PROFILE" Style="{StaticResource T.Label}" VerticalAlignment="Center" />
                        <Button Style="{StaticResource Btn.Quiet}" Content="Switch ▾" Margin="8,0,0,0" Padding="4,0" MinHeight="20" FontSize="12"
                                Click="OnSwitchMenu" AutomationProperties.Name="Switch profile">
                            <Button.ContextMenu>
                                <ContextMenu ItemsSource="{Binding ProfileChoices}">
                                    <ContextMenu.ItemContainerStyle>
                                        <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                                            <Setter Property="Header" Value="{Binding}" />
                                            <Setter Property="Command" Value="{Binding DataContext.SwitchProfileCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                            <Setter Property="CommandParameter" Value="{Binding}" />
                                        </Style>
                                    </ContextMenu.ItemContainerStyle>
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                    </StackPanel>
                    <TextBlock Text="{Binding ProfileName}" Style="{StaticResource T.H1}" Margin="0,2,0,0" />
                </StackPanel>
            </DockPanel>

            <!-- what still needs setting up (Claude missing, mods folder, Decomp) -->
            <Border DockPanel.Dock="Top" Style="{StaticResource Panel.Warning}" Margin="0,0,0,14"
                    Visibility="{Binding SetupIssues, Converter={StaticResource VisibleWhen}}">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Open setup" Command="{Binding RunSetupCommand}" MinHeight="32" FontSize="13" />
                    <TextBlock Text="{Binding SetupIssues}" Style="{StaticResource T.Body}" FontSize="13" Foreground="{StaticResource B.AmberText}"
                               VerticalAlignment="Center" Margin="0,0,12,0" />
                </DockPanel>
            </Border>

            <!-- status chips (one row replaces the old status lines) -->
            <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,16">
                <Button Style="{StaticResource Btn.Chip.Amber}" Margin="0,0,8,8" Command="{Binding UpdateAllCommand}"
                        ToolTip="{Binding UpdatesSummary}"
                        Visibility="{Binding UpdateCount, Converter={StaticResource VisibleWhen}}">
                    <TextBlock>
                        <Run Text="↑ " /><Run Text="{Binding UpdateCount, Mode=OneWay}" /><Run Text=" updates · Update all" />
                    </TextBlock>
                </Button>
                <Button Style="{StaticResource Btn.Chip.Salmon}" Margin="0,0,8,8" Command="{Binding ShowConflictsCommand}"
                        Visibility="{Binding ConflictCount, Converter={StaticResource VisibleWhen}}">
                    <TextBlock>
                        <Run Text="⇄ " /><Run Text="{Binding ConflictCount, Mode=OneWay}" /><Run Text=" conflicts · Review" />
                    </TextBlock>
                </Button>
                <Button Style="{StaticResource Btn.Chip}" Margin="0,0,8,8" Command="{Binding LinkAllCommand}"
                        Visibility="{Binding UnlinkedCount, Converter={StaticResource VisibleWhen}}">
                    <TextBlock>
                        <Run Text="{Binding UnlinkedCount, Mode=OneWay}" /><Run Text=" not linked to VostokMods · Link" />
                    </TextBlock>
                </Button>
                <Button Style="{StaticResource Btn.Chip}" Margin="0,0,8,8" Command="{Binding SyncDriftCommand}" Content="{Binding DriftText}"
                        Visibility="{Binding DriftText, Converter={StaticResource VisibleWhen}}" />
                <Button Style="{StaticResource Btn.Quiet}" Margin="0,0,8,8" Content="Refresh" Command="{Binding RefreshAllCommand}"
                        ToolTip="Rescan the mods folder, re-detect conflicts and check VostokMods for updates now." />
                <TextBlock Text="{Binding InstallProgress}" Style="{StaticResource T.Muted}" VerticalAlignment="Center" Margin="4,0,0,8" />
            </WrapPanel>

            <!-- filter tabs -->
            <Border DockPanel.Dock="Top" BorderBrush="{StaticResource B.Hairline}" BorderThickness="0,0,0,1">
                <DockPanel>
                    <ItemsControl ItemsSource="{Binding Tabs}" Focusable="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:FilterTab}">
                                <RadioButton Style="{StaticResource Tab.Item}" GroupName="modsFilter"
                                             IsChecked="{Binding IsActive, Mode=OneWay}"
                                             Command="{Binding DataContext.SetFilterCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                             CommandParameter="{Binding Key}">
                                    <TextBlock>
                                        <Run Text="{Binding Label, Mode=OneWay}" />
                                        <Run Text="{Binding Count, Mode=OneWay}" FontSize="13" Foreground="{StaticResource B.Text4}" />
                                    </TextBlock>
                                </RadioButton>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </DockPanel>
            </Border>

            <!-- footer bar -->
            <Border DockPanel.Dock="Bottom" Style="{StaticResource Panel.Notice}" Margin="0,14,0,0">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Style="{StaticResource Btn.Quiet}" Content="Enable all" Command="{Binding EnableAllCommand}" />
                        <Button Style="{StaticResource Btn.Quiet}" Content="Disable all" Command="{Binding DisableAllCommand}" Margin="0,0,8,0" />
                        <Button Content="Undo last change" MinHeight="32" FontSize="13" Margin="0,0,8,0"
                                ToolTip="{Binding CheckpointText}"
                                Visibility="{Binding HasCheckpoint, Converter={StaticResource VisibleWhen}}"
                                Command="{Binding DataContext.UndoCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                        <Button Content="Analyze last log" MinHeight="32" FontSize="13"
                                Command="{Binding DataContext.GoCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="tools" />
                    </StackPanel>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding Footer}" Style="{StaticResource T.Muted}" />
                        <TextBlock Text="{Binding CheckpointText}" FontSize="12" Foreground="{StaticResource B.Text4}"
                                   Visibility="{Binding CheckpointText, Converter={StaticResource VisibleWhen}}" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- column header -->
            <Grid DockPanel.Dock="Top" Height="34">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="{StaticResource Col.On}" />
                    <ColumnDefinition Width="{StaticResource Col.Pos}" />
                    <ColumnDefinition Width="{StaticResource Col.Ord}" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="{StaticResource Col.Ver}" />
                    <ColumnDefinition Width="{StaticResource Col.Status}" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="ON" Style="{StaticResource T.Label}" Margin="14,0,0,0" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="#" Style="{StaticResource T.Label}" VerticalAlignment="Center"
                           ToolTip="Load position among the enabled mods shown" />
                <TextBlock Grid.Column="2" Text="ORDER" Style="{StaticResource T.Label}" VerticalAlignment="Center" Margin="4,0,0,0"
                           ToolTip="Load-order priority: lower loads earlier. Click a number to edit it." />
                <TextBlock Grid.Column="3" Text="MOD" Style="{StaticResource T.Label}" VerticalAlignment="Center" />
                <TextBlock Grid.Column="4" Text="VERSION" Style="{StaticResource T.Label}" VerticalAlignment="Center" />
                <TextBlock Grid.Column="5" Text="STATUS" Style="{StaticResource T.Label}" VerticalAlignment="Center" />
            </Grid>

            <!-- the list: drag rows to reorder, drop files to install -->
            <ListBox x:Name="List" ItemsSource="{Binding Rows}" SelectedItem="{Binding Selected}"
                     SelectionMode="Extended" SelectionChanged="OnSelectionChanged"
                     AllowDrop="True" PreviewMouseLeftButtonDown="OnRowMouseDown" PreviewMouseMove="OnRowMouseMove"
                     MouseDoubleClick="OnRowDoubleClick" KeyDown="OnListKeyDown"
                     AutomationProperties.Name="Mods">
                <ListBox.ItemTemplateSelector>
                    <vm:ModRowTemplateSelector ModTemplate="{StaticResource ModRowTemplate}"
                                               PackTemplate="{StaticResource PackRowTemplate}" />
                </ListBox.ItemTemplateSelector>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource Row.Item}">
                        <Setter Property="Tag" Value="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ListBox}}" />
                        <Setter Property="ContextMenu" Value="{StaticResource RowMenu}" />
                    </Style>
                </ListBox.ItemContainerStyle>
            </ListBox>
        </DockPanel>

        <!-- ═══ details panel ═════════════════════════════════════════ -->
        <Border Grid.Column="2" Background="{StaticResource B.Rail}" BorderBrush="{StaticResource B.Hairline}"
                BorderThickness="1,0,0,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="28,26,28,24"
                            Visibility="{Binding Selected, Converter={StaticResource VisibleWhen}}">
                    <TextBlock Text="{Binding SelectedName}" Style="{StaticResource T.H2}" />
                    <TextBlock Text="{Binding SelectedMeta}" Style="{StaticResource T.Muted}" Margin="0,6,0,18" />

                    <WrapPanel Margin="0,0,0,14">
                        <Button Style="{StaticResource Btn.Primary}" Content="{Binding SelectedUpdateLabel}" Margin="0,0,8,8"
                                Command="{Binding UpdateSelectedCommand}"
                                Visibility="{Binding SelectedCanUpdate, Converter={StaticResource VisibleWhen}}" />
                        <Button Content="VostokMods page" Margin="0,0,8,8" Command="{Binding OpenPageCommand}"
                                Visibility="{Binding SelectedIsLinked, Converter={StaticResource VisibleWhen}}" />
                        <Button Content="Link to VostokMods…" Margin="0,0,8,8" Command="{Binding LinkSelectedCommand}"
                                Visibility="{Binding SelectedIsLinked, Converter={StaticResource VisibleWhen}, ConverterParameter=invert}" />
                        <Button Content="Show folder" Margin="0,0,8,8" Command="{Binding ShowInFolderCommand}" />
                        <Button Style="{StaticResource Btn.Link}" Content="Change link…" Margin="0,0,8,8" Command="{Binding LinkSelectedCommand}"
                                Visibility="{Binding SelectedIsLinked, Converter={StaticResource VisibleWhen}}" />
                    </WrapPanel>

                    <Border BorderBrush="{StaticResource B.Hairline}" BorderThickness="0,0,0,1" Margin="0,0,0,16">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Style="{StaticResource Tab.Item}" GroupName="modDetail" Content="Overview"
                                         IsChecked="{Binding DetailTab, Converter={StaticResource EqualsParam}, ConverterParameter=overview, Mode=OneWay}"
                                         Command="{Binding SetDetailTabCommand}" CommandParameter="overview" />
                            <RadioButton Style="{StaticResource Tab.Item}" GroupName="modDetail" Content="Changelog"
                                         IsEnabled="{Binding SelectedHasChangelog}"
                                         ToolTipService.ShowOnDisabled="True" ToolTip="Shown when the mod's archive carries a changelog file"
                                         IsChecked="{Binding DetailTab, Converter={StaticResource EqualsParam}, ConverterParameter=changelog, Mode=OneWay}"
                                         Command="{Binding SetDetailTabCommand}" CommandParameter="changelog" />
                            <RadioButton Style="{StaticResource Tab.Item}" GroupName="modDetail" Content="Settings"
                                         IsChecked="{Binding DetailTab, Converter={StaticResource EqualsParam}, ConverterParameter=settings, Mode=OneWay}"
                                         Command="{Binding SetDetailTabCommand}" CommandParameter="settings" />
                        </StackPanel>
                    </Border>

                    <!-- changelog tab -->
                    <c:MarkdownView Markdown="{Binding ChangelogText}" FontSize="14" Foreground="{StaticResource B.Text2}"
                                    VerticalScrollBarVisibility="Disabled"
                                    Visibility="{Binding DetailTab, Converter={StaticResource TabVisible}, ConverterParameter=changelog}" />

                    <!-- settings tab (MCM editing lands later) -->
                    <TextBlock Style="{StaticResource T.Muted}"
                               Text="Editing a mod's MCM settings here, without starting the game, is coming next. For now, change them in the game's Mod Configuration Menu."
                               Visibility="{Binding DetailTab, Converter={StaticResource TabVisible}, ConverterParameter=settings}" />

                    <!-- overview tab -->
                    <StackPanel Visibility="{Binding DetailTab, Converter={StaticResource TabVisible}, ConverterParameter=overview}">
                    <c:MarkdownView Markdown="{Binding SelectedDescription}" Foreground="{StaticResource B.Text2}"
                                    VerticalScrollBarVisibility="Disabled" Margin="0,0,0,10" />
                    <Button Style="{StaticResource Btn.Link}" Content="Refresh description" HorizontalAlignment="Left" Margin="0,0,0,16"
                            Command="{Binding RefreshDescriptionCommand}" Visibility="{Binding SelectedIsLinked, Converter={StaticResource VisibleWhen}}" />

                    <DockPanel Margin="0,0,0,6">
                        <Button DockPanel.Dock="Right" Style="{StaticResource Btn.Link}" Content="Edit…" Command="{Binding EditDependenciesCommand}" Padding="4,0" />
                        <TextBlock Text="DEPENDS ON" Style="{StaticResource T.Label}" VerticalAlignment="Center" />
                    </DockPanel>
                    <TextBlock Style="{StaticResource T.Muted}" Margin="0,0,0,16" TextWrapping="Wrap"
                               Text="This mod declares no dependencies in its mod.txt. Edit… adds the mods it needs, so they're fetched with it."
                               Visibility="{Binding SelectedHasNoDependencies, Converter={StaticResource VisibleWhen}}" />
                    <ItemsControl ItemsSource="{Binding SelectedDependencies}" Margin="0,0,0,20" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type svc:DependencyView}">
                                <Border BorderBrush="{StaticResource B.HairlineSoft}" BorderThickness="0,0,0,1" Padding="0,8">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding StatusText}" FontSize="12" Foreground="{StaticResource B.Text3}"
                                                   MaxWidth="170" TextWrapping="Wrap" TextAlignment="Right" />
                                        <TextBlock FontSize="14">
                                            <Run Text="{Binding Glyph, Mode=OneWay}" /><Run Text="  " /><Run Text="{Binding ModId, Mode=OneWay}" />
                                            <Run Text="{Binding Kind, Mode=OneWay}" FontSize="12" Foreground="{StaticResource B.Text4}" />
                                        </TextBlock>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <ItemsControl ItemsSource="{Binding SelectedConflictViews}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type svc:ConflictView}">
                                <Border Style="{StaticResource Panel.Conflict}" Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource T.Label}" Foreground="{StaticResource B.SalmonText}">
                                            <Run Text="CONFLICT · " /><Run Text="{Binding Severity, Mode=OneWay}" />
                                        </TextBlock>
                                        <TextBlock Text="{Binding Title}" Style="{StaticResource T.Body}" FontSize="14" Margin="0,6,0,2" />
                                        <TextBlock Text="{Binding Subtitle}" Style="{StaticResource T.Mono}" Margin="0,0,0,6" />
                                        <TextBlock FontSize="13" Foreground="{StaticResource B.Text2}" TextWrapping="Wrap">
                                            <Run Text="Wins: " /><Run Text="{Binding Winner.Text, Mode=OneWay}" Foreground="{StaticResource B.Text}" />
                                        </TextBlock>
                                        <TextBlock Text="{Binding Winner.Why}" FontSize="12" Foreground="{StaticResource B.Text3}" TextWrapping="Wrap" Margin="0,2,0,0" />
                                        <Button Content="Ask Claude to resolve" HorizontalAlignment="Left" Margin="0,10,0,0" MinHeight="32" FontSize="13"
                                                ToolTip="{Binding ResolveHint}"
                                                Command="{Binding DataContext.ResolveConflictCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Visibility="{Binding HasResolveButton, Converter={StaticResource VisibleWhen}}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="IN THIS PROFILE" Style="{StaticResource T.Label}" Margin="0,8,0,8" />
                    <CheckBox Content="Testing build (DEV)" IsChecked="{Binding SelectedIsTesting, Mode=OneWay}"
                              Command="{Binding ToggleTestingCommand}" Margin="0,0,0,10" />
                    <CheckBox Content="Lock this version" IsChecked="{Binding SelectedIsLocked, Mode=OneWay}" IsEnabled="{Binding SelectedCanLock}"
                              ToolTipService.ShowOnDisabled="True" ToolTip="Built-in mods are always kept; nothing to lock."
                              Command="{Binding ToggleLockCommand}" Margin="0,0,0,14" />
                    <TextBlock Text="Personal note" FontSize="14" Margin="0,0,0,6" />
                    <TextBox x:Name="NoteBox" Text="{Binding SelectedNote, Mode=OneWay}" AcceptsReturn="True"
                             TextWrapping="Wrap" MinHeight="64" FontSize="14" LostFocus="OnNoteLostFocus"
                             AutomationProperties.Name="Personal note" />

                    <Border BorderBrush="{StaticResource B.Hairline}" BorderThickness="0,1,0,0" Margin="0,18,0,0" Padding="0,8,0,0">
                        <WrapPanel>
                            <Button Style="{StaticResource Btn.Link}" Content="Earlier versions…" Command="{Binding RevertCommand}" Margin="0,0,10,0"
                                    Visibility="{Binding SelectedHasBackups, Converter={StaticResource VisibleWhen}}" />
                            <Button Style="{StaticResource Btn.Link}" Content="Remove from profile…" Command="{Binding DeleteCommand}"
                                    Foreground="{StaticResource B.SalmonText}" />
                        </WrapPanel>
                    </Border>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
