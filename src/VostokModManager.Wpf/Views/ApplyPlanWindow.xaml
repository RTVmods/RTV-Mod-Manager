<Window x:Class="VostokModManager.Wpf.Views.ApplyPlanWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:VostokModManager.Wpf.ViewModels"
        Width="1040" Height="740" MinWidth="760" MinHeight="480"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource B.Rail}" Foreground="{StaticResource B.Text}"
        FontFamily="{StaticResource Font.Lora}" FontSize="{StaticResource Size.Body}" UseLayoutRounding="True">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="30" ResizeBorderThickness="6" GlassFrameThickness="0" />
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <!-- A row whose source can't change shows its one choice dimmed. -->
        <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.5" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Border BorderBrush="{StaticResource B.Edge}" BorderThickness="1" Background="{StaticResource B.Rail}">
        <DockPanel Margin="28,24,28,22">
            <TextBlock DockPanel.Dock="Top" Text="APPLY TO THE LIVE MODS FOLDER" Style="{StaticResource T.Label}" />
            <TextBlock DockPanel.Dock="Top" Text="{Binding Title}" Style="{StaticResource T.H2}" Margin="0,4,0,8" />
            <TextBlock DockPanel.Dock="Top" Text="{Binding Summary}" Style="{StaticResource T.Muted}" Margin="0,0,0,10" />
            <Border DockPanel.Dock="Top" Style="{StaticResource Panel.Warning}" Margin="0,0,0,14">
                <TextBlock Text="{Binding Warning}" Style="{StaticResource T.Body}" FontSize="13" LineHeight="20"
                           Foreground="{StaticResource B.AmberText}" />
            </Border>

            <DockPanel DockPanel.Dock="Bottom" Margin="0,16,0,0">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="{Binding CloseLabel}" Margin="0,0,8,0" Click="OnClose" />
                    <Button Style="{StaticResource Btn.Primary}" Content="{Binding RunLabel}" Command="{Binding RunCommand}"
                            IsEnabled="{Binding CanRun}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Button Style="{StaticResource Btn.Quiet}" Content="Select all" Command="{Binding SelectAllCommand}" IsEnabled="{Binding CanRun}" />
                    <Button Style="{StaticResource Btn.Quiet}" Content="None" Command="{Binding SelectNoneCommand}" IsEnabled="{Binding CanRun}" />
                </StackPanel>
            </DockPanel>

            <Border DockPanel.Dock="Bottom" Style="{StaticResource Panel.Notice}" Margin="0,12,0,0" MaxHeight="150"
                    Visibility="{Binding HasLog, Converter={StaticResource VisibleWhen}}">
                <ScrollViewer x:Name="LogScroll" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Log}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" Style="{StaticResource T.Mono}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>

            <!-- column header -->
            <Border DockPanel.Dock="Top" BorderBrush="{StaticResource B.Hairline}" BorderThickness="0,0,0,1" Height="30">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="44" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="170" />
                        <ColumnDefinition Width="300" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="1" Text="MOD" Style="{StaticResource T.Label}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2" Text="SOURCE" Style="{StaticResource T.Label}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="3" Text="WHAT HAPPENS" Style="{StaticResource T.Label}" VerticalAlignment="Center" Margin="14,0,0,0" />
                </Grid>
            </Border>

            <ListBox ItemsSource="{Binding Rows}" AutomationProperties.Name="Apply plan">
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:ApplyRowItem}">
                        <Grid MinHeight="52">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="44" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="170" />
                                <ColumnDefinition Width="300" />
                            </Grid.ColumnDefinitions>
                            <CheckBox IsChecked="{Binding Apply}" IsEnabled="{Binding IsCheckable}" Margin="12,0,0,0"
                                      AutomationProperties.Name="{Binding Label}" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                                <TextBlock TextTrimming="CharacterEllipsis">
                                    <Run Text="{Binding Label, Mode=OneWay}" />
                                    <Run Text="{Binding Version, Mode=OneWay}" FontSize="13" Foreground="{StaticResource B.Text2}" />
                                </TextBlock>
                                <TextBlock Text="{Binding Installed}" FontSize="12" Foreground="{StaticResource B.Text4}" />
                            </StackPanel>
                            <ComboBox Grid.Column="2" ItemsSource="{Binding SourceChoices}" SelectedItem="{Binding Source}"
                                      IsEnabled="{Binding SourceIsChangeable}" VerticalAlignment="Center" FontSize="13" MinHeight="34"
                                      AutomationProperties.Name="{Binding SourceName}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Label}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <TextBlock Grid.Column="3" FontSize="13" Foreground="{StaticResource B.Text2}" VerticalAlignment="Center"
                                       TextWrapping="Wrap" Margin="14,0,8,0">
                                <Run Text="{Binding StatusIcon, Mode=OneWay}" /><Run Text=" " /><Run Text="{Binding StatusText, Mode=OneWay}" />
                            </TextBlock>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>
    </Border>
</Window>
