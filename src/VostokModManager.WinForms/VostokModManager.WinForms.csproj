<Project Sdk="Microsoft.NET.Sdk">

  <!-- The original WinForms front end. Kept building and shippable as the
       reference implementation until the WPF front end reaches parity;
       removed at cutover. Shared settings (version, editions, release
       single-file publish) come from Directory.Build.props/.targets. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>VostokModManager</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\VostokModManager.Core\VostokModManager.Core.csproj" />
  </ItemGroup>

  <!-- Embedded VostokMods browser. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2792.45" />
  </ItemGroup>

  <PropertyGroup Condition="'$(EnableAI)' == 'true'">
    <AssemblyName>VostokModManagerAI</AssemblyName>
    <Product>Vostok Mod Manager AI</Product>
    <ApplicationIcon>icon.ico</ApplicationIcon>
  </PropertyGroup>

  <PropertyGroup Condition="'$(EnableAI)' != 'true'">
    <AssemblyName>VostokModManagerIntegrated</AssemblyName>
    <Product>Vostok Mod Manager Integrated</Product>
    <ApplicationIcon>icon-integrated.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup Condition="'$(EnableAI)' != 'true'">
    <Compile Remove="Ui\ResolutionDialog.cs" />
  </ItemGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <PublishDir>$(MSBuildThisFileDirectory)..\..\publish\$(VmmEdition)\</PublishDir>
  </PropertyGroup>

</Project>
