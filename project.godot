; Engine configuration file.
;
; Vostok Mod Manager — standalone Godot 4.6 application. Manages
; Road to Vostok mods from outside the running game: enable/disable,
; track ModWorkshop updates, detect conflicts, AI-resolve overlaps via
; local Claude Code subprocess.

config_version=5

[application]

config/name="Vostok Mod Manager"
config/description="Standalone mod manager for Road to Vostok"
run/main_scene="res://scenes/MainScreen.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")
config/icon="res://icon.svg"

[display]

window/size/viewport_width=1280
window/size/viewport_height=800
window/size/initial_position_type=2

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
